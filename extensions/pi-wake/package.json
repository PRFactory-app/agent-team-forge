{
  "name": "agent-team-forge-pi-wake",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension for AgentTeamForge notice-only job wakes",
  "type": "module",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check \"index.ts\" \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:write": "prettier --write \"index.ts\" \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vitest": "4.1.11"
  }
}
