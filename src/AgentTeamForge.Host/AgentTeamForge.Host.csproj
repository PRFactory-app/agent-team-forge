<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>atf</AssemblyName>
    <RootNamespace>AgentTeamForge.Host</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AgentTeamForge.Business/AgentTeamForge.Business.csproj" />
    <!-- DAL reference is composition-only (daemon role); endpoints go through Business. -->
